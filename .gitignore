# Harness runtime logs and temporary files.
**/_dbg/
.gate/
*.log
*.tmp
~$*

# Binary Excel workbooks are human-managed runtime artifacts (churn every
# harness run) — the src\ beside them is the tracked source of truth.
*.xlsb
*.xlsm
*.xlsx
*.xlam

# dist artifacts (built by vbaloop dist)
dist/

# test templates
test_*/
archive/
releases/

# vbaloop:managed:start
_dbg/
dist/
# vbaloop:managed:end
