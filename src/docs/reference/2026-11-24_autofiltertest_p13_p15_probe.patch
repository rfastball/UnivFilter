+' ==========================================================================
+' P15: "<>" 스칼라 재실험 - 텍스트 열(255자 초과 값이 사는 곳) 한정 의미론
+'      (UnivFilter 리뷰 버그2: 제외 모드 여집합 배열이 긴 값을 탈락시키는 문제의
+'      대체 수단 판정. P10은 숫자 혼합 열 기준이었다.)
+' ==========================================================================
+Private Sub P15_NotEqualTextColumn()
+    Dim ws As Worksheet
+    Set ws = modProbeUtil.EnsureSheet(GAP_SHEET)
+    ws.Cells.Clear
+    ws.AutoFilterMode = False
+    ws.Columns("A").ColumnWidth = 30
+    ws.Cells(1, 1).Value = "Value"
+    ws.Cells(1, 2).Value = "CaseName"
+
+    Dim long1 As String, long2 As String
+    long1 = String$(300, "L")
+    long2 = String$(300, "M")
+    PutFmt ws, 2, long1, "@", "L_long1"
+    PutFmt ws, 3, long2, "@", "L_long2"
+    PutFmt ws, 4, "a", "@", "T_a"
+    PutFmt ws, 5, "A", "@", "T_A"
+    PutFmt ws, 6, "b", "@", "T_b"
+    PutFmt ws, 7, "a*b", "@", "T_star"
+    PutFmt ws, 8, "a?c", "@", "T_q"
+    PutFmt ws, 9, "a~b", "@", "T_tilde"
+    PutFmt ws, 10, "axb", "@", "T_axb"
+    PutFmt ws, 11, "123", "@", "T_numtxt"
+    PutFmt ws, 12, 123, "General", "N_123"
+    PutFmt ws, 13, "5 kg", "@", "T_kg_twin"
+    PutFmt ws, 14, 5, "0"" kg""", "N_kg"
+    PutFmt ws, 15, "ID-abc", "@", "T_idtwin"
+    PutFmt ws, 16, "abc", """ID-""@", "T_pre"
+    PutFmt ws, 17, "a ", "@", "T_space"
+    ws.Cells(18, 2).Value = "R_BLANK"              ' A18 빈칸
+
+    Dim dr As String
+    dr = "A1:A18"
+    TryOneCriteria ws, dr, "P15", "ne_a", "<>a", 0, Empty, 2, 18, -1
+    TryOneCriteria ws, dr, "P15", "ne_a_space", "<>a ", 0, Empty, 2, 18, -1
+    TryOneCriteria ws, dr, "P15", "ne_star_raw", "<>a*b", 0, Empty, 2, 18, -1
+    TryOneCriteria ws, dr, "P15", "ne_star_esc", "<>a~*b", 0, Empty, 2, 18, -1
+    TryOneCriteria ws, dr, "P15", "ne_q_raw", "<>a?b", 0, Empty, 2, 18, -1
+    TryOneCriteria ws, dr, "P15", "ne_q_esc", "<>a~?c", 0, Empty, 2, 18, -1
+    TryOneCriteria ws, dr, "P15", "ne_tilde_raw", "<>a~b", 0, Empty, 2, 18, -1
+    TryOneCriteria ws, dr, "P15", "ne_tilde_esc", "<>a~~b", 0, Empty, 2, 18, -1
+    TryOneCriteria ws, dr, "P15", "ne_numtxt", "<>123", 0, Empty, 2, 18, -1
+    TryOneCriteria ws, dr, "P15", "ne_kg", "<>5 kg", 0, Empty, 2, 18, -1
+    TryOneCriteria ws, dr, "P15", "ne_id_display", "<>ID-abc", 0, Empty, 2, 18, -1
+    TryOneCriteria ws, dr, "P15", "ne_id_raw", "<>abc", 0, Empty, 2, 18, -1
+    TryOneCriteria ws, dr, "P15", "ne_long", "<>" & long1, 0, Empty, 2, 18, -1
+    TryAnd ws, dr, "and_a_b", "<>a", "<>b"
+    TryAnd ws, dr, "and_long_a", "<>" & long1, "<>a"
+    ' 부수: 등호 스칼라/배열의 와일드카드 해석 여부 (현행 긴 값 등호 경로 영향)
+    TryOneCriteria ws, dr, "P15", "eq_star_raw", "=a*b", 0, Empty, 2, 18, -1
+    TryOneCriteria ws, dr, "P15", "eq_q_raw", "=a?b", 0, Empty, 2, 18, -1
+    TryOneCriteria ws, dr, "P15", "arr_star", Array("a*b"), 0, Empty, 2, 18, -1
+    TryOneCriteria ws, dr, "P15", "arr_q", Array("a?b"), 0, Empty, 2, 18, -1
+    ' 배열/등호의 ~ 이스케이프와 끝 공백 처리
+    TryOneCriteria ws, dr, "P15", "arr_star_esc", Array("a~*b"), 0, Empty, 2, 18, -1
+    TryOneCriteria ws, dr, "P15", "arr_q_esc", Array("a~?c"), 0, Empty, 2, 18, -1
+    TryOneCriteria ws, dr, "P15", "arr_tilde", Array("a~b"), 0, Empty, 2, 18, -1
+    TryOneCriteria ws, dr, "P15", "arr_tilde_esc", Array("a~~b"), 0, Empty, 2, 18, -1
+    TryOneCriteria ws, dr, "P15", "eq_star_esc", "=a~*b", 0, Empty, 2, 18, -1
+    TryOneCriteria ws, dr, "P15", "arr_a", Array("a"), 0, Empty, 2, 18, -1
+    TryOneCriteria ws, dr, "P15", "arr_a_space", Array("a "), 0, Empty, 2, 18, -1
+    TryOneCriteria ws, dr, "P15", "eq_a", "=a", 0, Empty, 2, 18, -1
+    TryOneCriteria ws, dr, "P15", "arr_star_mix", Array("a~*b", "b"), 0, Empty, 2, 18, -1
+
+    ws.AutoFilterMode = False
+End Sub
