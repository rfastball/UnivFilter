+Private Sub P16_Whitespace()
+    Dim ws As Worksheet
+    Set ws = modProbeUtil.EnsureSheet(GAP_SHEET)
+    ws.Cells.Clear
+    ws.AutoFilterMode = False
+    ws.Cells(1, 1).Value = "Value"
+    ws.Cells(1, 2).Value = "CaseName"
+    Dim fw As String, nb As String
+    fw = ChrW(&H3000)
+    nb = ChrW(160)
+    PutText ws, 2, "a", "@", "T_a"
+    PutText ws, 3, "a ", "@", "T_tsp"
+    PutText ws, 4, " a", "@", "T_lsp"
+    PutText ws, 5, "a  ", "@", "T_tsp2"
+    PutText ws, 6, fw & "a", "@", "T_lfw"
+    PutText ws, 7, "a" & fw, "@", "T_tfw"
+    PutText ws, 8, "a" & nb, "@", "T_tnb"
+    PutText ws, 9, "a b", "@", "T_in1"
+    PutText ws, 10, "a  b", "@", "T_in2"
+    PutFmt ws, 11, 1234, "#,##0_)", "N_pad"
+    PutFmt ws, 12, 1234, "#,##0", "N_plain"
+    PutText ws, 13, " a ", "@", "T_both"
+
+    Dim dr As String, crit As Variant, nm As Variant, i As Long
+    dr = "A1:A13"
+    crit = Array("a", "a ", " a", fw & "a", "a" & fw, "a" & nb, "a b", "a  b", "1,234", "1,234 ", " a ")
+    nm = Array("a", "a_tsp", "a_lsp", "a_lfw", "a_tfw", "a_tnb", "in1", "in2", "n", "n_tsp", "both")
+    For i = LBound(crit) To UBound(crit)
+        TryOneCriteria ws, dr, "P16", "a1_" & nm(i), Array(crit(i)), 0, Empty, 2, 13, -1
+        TryOneCriteria ws, dr, "P16", "a3_" & nm(i), Array(crit(i), "zz1", "zz2"), 0, Empty, 2, 13, -1
+    Next i
+    TryOneCriteria ws, dr, "P16", "eq_a", "=a", 0, Empty, 2, 13, -1
+    TryOneCriteria ws, dr, "P16", "eq_lsp", "= a", 0, Empty, 2, 13, -1
+    ws.AutoFilterMode = False
+End Sub
