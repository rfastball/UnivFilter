+    dr = "A1:A9"
+    TryOneCriteria ws, dr, "P16b", "arr_eq", Array("="), 0, Empty, 2, 9, -1
+    TryOneCriteria ws, dr, "P16b", "arr_empty", Array(""), 0, Empty, 2, 9, -1
+    TryOneCriteria ws, dr, "P16b", "arr_sp3", Array("   "), 0, Empty, 2, 9, -1
+    TryOneCriteria ws, dr, "P16b", "arr3_eq", Array("=", "zz1", "zz2"), 0, Empty, 2, 9, -1
+    TryOneCriteria ws, dr, "P16b", "arr3_empty", Array("", "zz1", "zz2"), 0, Empty, 2, 9, -1
+    TryOneCriteria ws, dr, "P16b", "arr3_sp3", Array("   ", "zz1", "zz2"), 0, Empty, 2, 9, -1
+    TryOneCriteria ws, dr, "P16b", "scalar_eq", "=", 0, Empty, 2, 9, -1
+    TryOneCriteria ws, dr, "P16b", "arr_a", Array("a"), 0, Empty, 2, 9, -1
+    TryOneCriteria ws, dr, "P16b", "arr3_a", Array("a", "zz1", "zz2"), 0, Empty, 2, 9, -1
+    TryOneCriteria ws, dr, "P16b", "arr3_ttab", Array("a" & vbTab, "zz1", "zz2"), 0, Empty, 2, 9, -1
+    TryOneCriteria ws, dr, "P16b", "arr3_tlf", Array("a" & vbLf, "zz1", "zz2"), 0, Empty, 2, 9, -1
+    ' 제외 시나리오: b 만 빼고 남길 목록(빈칸 포함)
+    TryOneCriteria ws, dr, "P16b", "keep_all_but_b", Array("a", "=", "a" & vbTab, vbTab & "a", "a" & vbLf), 0, Empty, 2, 9, -1
